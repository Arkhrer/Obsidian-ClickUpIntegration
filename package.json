{
	"name": "obsidian-clickup-integration",
	"version": "0.0.1",
	"private": true,
	"description": "Obsidian plugin that integrates ClickUp tasks.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node scripts/link-test-vault.mjs && node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint .",
		"link": "node scripts/link-test-vault.mjs",
		"reload": "obsidian plugin:reload id=clickup-integration",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"author": "Arkhrer",
	"license": "UNLICENSED",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "22.20.5",
		"esbuild": "0.25.5",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"obsidian": "1.14.4",
		"typescript": "5.8.3",
		"typescript-eslint": "8.72.1"
	},
	"overrides": {
		"eslint-plugin-obsidianmd": {
			"obsidian": "$obsidian"
		}
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	}
}
